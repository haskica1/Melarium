# ─────────────────────────────────────────────────────────────────────────────
# Melarium — production environment variables for docker-compose.yml
#
# On the VPS:
#   cp .env.example .env
#   # then fill in real values below
#   nano .env
#
# .env is git-ignored — never commit it. docker-compose.yml reads it automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=MelariumDB
POSTGRES_USER=melarium
POSTGRES_PASSWORD=change-me-strong-random-password

# ── Domain ──────────────────────────────────────────────────────────────────
# Your real domain (no protocol, no trailing slash). Used for CORS, email links,
# and the base URL embedded in hive QR codes.
DOMAIN=melarium.app

# ── Backend secrets ───────────────────────────────────────────────────────────
# JWT signing key — at least 32 random characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-random-string

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Resend API key (starts with re_) — created at resend.com/api-keys with the
# "Sending access" permission. This is the SMTP password; the username is the
# literal string "resend". Leave empty to skip email sending entirely.
SMTP_PASSWORD=

# Sender address. Must be on a domain verified in Resend (resend.com/domains),
# otherwise Resend rejects the message. Before your domain is verified you can
# only send from onboarding@resend.dev.
SMTP_FROM_EMAIL=noreply@melarium.app

# Only needed to switch away from Resend — the defaults below are already
# correct for it. Port 587 is STARTTLS, which is what EmailService uses.
#SMTP_HOST=smtp.resend.com
#SMTP_PORT=587
#SMTP_USERNAME=resend
#SMTP_FROM_NAME=Melarium

# Groq API key — voice-note transcription, AI advisor, AI assistant, photo
# analysis. Leave empty to disable those features.
GROQ_API_KEY=

# ── AI assistant (SPEC-17) ───────────────────────────────────────────────────
# Model used to turn a spoken command into structured actions. Defaults to the
# same Llama the rest of the app's text features use; override only to try
# another Groq model.
#Groq__AssistantModel=llama-3.3-70b-versatile
#
# Ceiling on how many records ONE command may create ("sve košnice na X").
# Above it nothing is offered for confirmation and the user is asked to narrow
# the command. Default 50.
#Ai__MaxActionsPerCommand=50

# ── Feedback notifications (SPEC-13) ─────────────────────────────────────────
# Where "new feedback" e-mail is sent. This is one fixed operations address, not
# each SystemAdmin's own address — adding a second admin must not multiply the
# mail. Leave empty to skip the e-mail: submissions are still saved and every
# SystemAdmin still gets the in-app notification.
FEEDBACK_NOTIFY_EMAIL=

# ── Invite a friend (SPEC-15) ────────────────────────────────────────────────
# All of these have working defaults in appsettings.json — set them here only to
# tune the offer without a redeploy.
#
# Trial days for someone who arrives through an invitation (standard trial is
# Plans:Trial:Days = 30). This is the "primamljiva ponuda" half of the feature.
INVITE_INVITEE_TRIAL_DAYS=60
# Days the inviter's organization earns per invitee who verifies their e-mail.
INVITE_REWARD_DAYS=30
# Lifetime ceiling per organization. This is the only thing bounding what the
# feature can cost if someone farms fake accounts — do not raise it casually.
INVITE_REWARD_MAX_DAYS_PER_ORG=180
# Rewards allowed in any rolling 30-day window, so an attack is slow enough to notice.
INVITE_REWARD_MAX_PER_30_DAYS=5

# ── First SystemAdmin account ─────────────────────────────────────────────────
# Created automatically on first production startup (see Program.cs). Demo
# accounts from appsettings.json are locked out in production.
SYSADMIN_EMAIL=you@example.com
SYSADMIN_PASSWORD=change-me-strong-random-password
