# ─────────────────────────────────────────────────────────────────────────────
# Melarium — production environment variables for docker-compose.yml
#
# On the VPS:
#   cp .env.example .env
#   # then fill in real values below
#   nano .env
#
# .env is git-ignored — never commit it. docker-compose.yml reads it automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=MelariumDB
POSTGRES_USER=melarium
POSTGRES_PASSWORD=change-me-strong-random-password

# ── Domain ──────────────────────────────────────────────────────────────────
# Your real domain (no protocol, no trailing slash). Used for CORS, email links,
# and the base URL embedded in hive QR codes.
DOMAIN=melarium.app

# ── Backend secrets ───────────────────────────────────────────────────────────
# JWT signing key — at least 32 random characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-random-string

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Resend API key (starts with re_) — created at resend.com/api-keys with the
# "Sending access" permission. This is the SMTP password; the username is the
# literal string "resend". Leave empty to skip email sending entirely.
SMTP_PASSWORD=

# Sender address. Must be on a domain verified in Resend (resend.com/domains),
# otherwise Resend rejects the message. Before your domain is verified you can
# only send from onboarding@resend.dev.
SMTP_FROM_EMAIL=noreply@melarium.app

# Only needed to switch away from Resend — the defaults below are already
# correct for it. Port 587 is STARTTLS, which is what EmailService uses.
#SMTP_HOST=smtp.resend.com
#SMTP_PORT=587
#SMTP_USERNAME=resend
#SMTP_FROM_NAME=Melarium

# Groq API key — voice-note transcription, AI advisor, photo analysis. Leave
# empty to disable those features.
GROQ_API_KEY=

# ── First SystemAdmin account ─────────────────────────────────────────────────
# Created automatically on first production startup (see Program.cs). Demo
# accounts from appsettings.json are locked out in production.
SYSADMIN_EMAIL=you@example.com
SYSADMIN_PASSWORD=change-me-strong-random-password
